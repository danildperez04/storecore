        </mxCell>

        <mxCell id="dbC" value="postgres  ·  postgres:16-alpine&#10;&#10;:5432  (interno)&#10;&#10;Base storecore&#10;Volumen storecore_pgdata&#10;14 entidades · 8 enums&#10;Health check: pg_isready&#10;Reinicio: unless-stopped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontColor=#1b5e20;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
