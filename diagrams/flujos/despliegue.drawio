        <mxCell id="webC" value="web  ·  nginx:alpine&#10;&#10;:80  :443&#10;&#10;Sirve el build de React&#10;Termina TLS (Let's Encrypt)&#10;Proxy /api  →  api:3000&#10;Health check: wget localhost&#10;Reinicio: unless-stopped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontColor=#e65100;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
