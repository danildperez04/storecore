        <mxCell id="cron" value="host  ·  cron&#10;&#10;0 2 * * *&#10;/opt/storecore/scripts/backup.sh&#10;pg_dump → backups/*.sql.gz&#10;Rotación a 14 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#616161;fontColor=#424242;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
