        </mxCell>

        <mxCell id="apiC" value="api  ·  node:22-alpine&#10;&#10;:3000  (interno)&#10;&#10;REST /api/v1/*&#10;helmet · CORS · ValidationPipe&#10;JWT guard · Roles guard&#10;Swagger en /api/docs&#10;Health check: /api/v1/health&#10;Reinicio: unless-stopped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
