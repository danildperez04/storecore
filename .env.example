# ============================================================
# StoreCore — Variables de entorno
# Copia este archivo a .env y reemplaza los valores.
#   cp .env.example .env
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ---------- Aplicación ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# ---------- Base de datos ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=storecore
DATABASE_USER=storecore
DATABASE_PASSWORD=cambiame_en_produccion
# NUNCA true fuera de una base de pruebas desechable.
# El esquema se cambia solo por migración.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_SSL=false

# ---------- Autenticación ----------
# Genera uno con: openssl rand -base64 64
JWT_SECRET=cambiame_por_un_secreto_aleatorio_de_64_caracteres
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ---------- CORS ----------
# Orígenes permitidos separados por coma. Sin barra final.
# En desarrollo: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---------- Frontend ----------
# En producción se usa la ruta relativa porque Nginx hace de proxy.
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=StoreCore
